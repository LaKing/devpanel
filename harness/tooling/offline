#!/bin/sh
# Run one declared tooling command with no network: a fresh network namespace
# with loopback only (bubblewrap --unshare-net). Bound read-only into every seat
# fence at /run/devpanel/tooling/offline (harness/fence.mjs TOOLING_BIN).
#
#   offline <program> [args...]      no "--" separator: the wrapper adds bwrap's own
#
# When that namespace cannot start (Codex's workspace-write sandbox refuses it:
# its seccomp filter denies every socket family but AF_UNIX, NETLINK included),
# the runtime's own denial is accepted only when proved for this process first:
# a seccomp filter is installed (inherited by the command, never removable) and
# creating a TCP or UDP socket, IPv4 or IPv6, is refused with EPERM. A filter
# that lets sockets be created (refusing only bind or listen, say) is not
# accepted. Loopback is refused too, so a command that listens on it fails here.
#
# When neither holds (a Claude seat's Bash sandbox: its seccomp filter keeps a
# command from making namespaces, so bwrap gets EPERM, while IP sockets can
# still be created there and reach the sandbox's proxy on loopback), the
# wrapper imposes the denial itself: a fixed-path Python installs a seccomp
# filter on this process (no privilege needed; inherited by everything it
# executes, never removable) under which socket() is refused with EPERM for
# every family, io_uring_setup with ENOSYS (it can create sockets too) and every
# syscall of a foreign ABI (i386's socketcall, x32) with EPERM; socketpair, and
# with it pipes to children, still works. It then runs this wrapper once more,
# and that second pass decides exactly as above: the command runs only when the
# verifier proves the denial. A machine whose syscall numbers are not listed
# below, a refused prctl, or a missing Python leaves exit 125.
#
# Nothing the seat's environment controls takes part in the decision: the
# dynamic loader's variables (LD_*) are dropped before anything is executed, so
# no preload reaches bwrap, the verifier or the command; bwrap and the verifier
# are fixed paths; the verifier runs with every variable unset, in Python's
# isolated mode; everything else here is a shell builtin (no PATH lookup). Only
# a verifier that exits 0 with a final line carrying the nonce made for this
# call counts as proof (one that stops early or fails proves nothing).
#
# Once isolation is decided, and only then, one thing is measured and reported,
# never decided on: whether a Node child's output can be read here. A fixed-path
# Node with every variable unset reads a child's stdout through execFile. An
# empty answer from a child that exited cleanly says "child output unobservable"
# on stderr, any other failure of the measurement "child output unchecked", and
# an intact answer says nothing. The command then runs the same either way, with
# its own exit code. The exit 125 path never gets here.
#
# Exit 64: usage. Exit 125: network isolation could not start in this seat, no
# denial was proved and none could be imposed, so the command was NOT run. There is no fallback to
# running it with network.
BWRAP=/usr/bin/bwrap
VERIFIER=/usr/bin/python3
IMPOSER=/usr/bin/python3
NODE=/usr/bin/node
NL='
'
# Unset every exported variable whose name matches the pattern $1 (builtins only).
drop () {
  while IFS= read -r line; do
    case $line in 'export '*|'declare -x '*) name=${line#export }; name=${name#declare -x }; name=${name%%=*}
      # A readonly variable would end the shell: it stays, and is never the loader's.
      case $name in $1) (unset "$name") 2>/dev/null && unset "$name" ;; esac ;;
    esac
  done <<EOF
$(export -p)
EOF
}
drop 'LD_*'
# Set only by this wrapper's own second pass (IMPOSE below). A seat that sets it
# gains nothing: it only skips the attempt to impose, and the proof still decides.
imposed=${DEVPANEL_OFFLINE_IMPOSED:-}
unset DEVPANEL_OFFLINE_IMPOSED
if [ "$#" -eq 0 ]; then echo 'devpanel-offline: usage: offline <program> [args...]' >&2; exit 64; fi
if [ "$1" = "--" ]; then echo 'devpanel-offline: no "--" separator; pass the program directly' >&2; exit 64; fi
nonce=
IFS= read -r nonce < /proc/sys/kernel/random/uuid 2>/dev/null
CHILD_PROBE='
const nonce = process.argv[1]
const bound = setTimeout(() => { console.log("failed " + nonce + " timeout"); process.exit(0) }, 15000)
require("node:child_process").execFile(process.execPath, ["-e", "process.stdout.write(process.argv[1])", nonce], { timeout: 12000 }, (e, out) => {
  clearTimeout(bound)
  if (e) console.log("failed " + nonce + " " + (e.killed ? "timeout" : String(e.code).replace(/[^A-Za-z0-9_-]/g, "")))
  else if (out === nonce) console.log("observed " + nonce)
  else if (out === "") console.log("discarded " + nonce)
  else console.log("failed " + nonce + " altered")
})
'
UNKNOWN="whether a Node child's output can be read here is unknown"
check_child_output () {
  answer=
  [ -n "$nonce" ] && answer=$(cd / && drop '*'; exec "$NODE" -e "$CHILD_PROBE" "$nonce" 2>/dev/null)
  case $answer in
    "observed $nonce") ;;
    "discarded $nonce") echo "devpanel-offline: child output unobservable [$nonce]: in this runtime's sandbox a Node child's output read through execFile came back empty (0 bytes); the command still runs and its exit code is its own, but empty output from a Node child here means it could not be observed, not that the child printed nothing; output a command writes directly is unaffected" >&2 ;;
    "failed $nonce "*) echo "devpanel-offline: child output unchecked [$nonce]: the measurement's Node child failed (${answer##* }); $UNKNOWN" >&2 ;;
    *) echo "devpanel-offline: child output unchecked [$nonce]: the measurement at $NODE gave no answer; $UNKNOWN" >&2 ;;
  esac
}
if err=$("$BWRAP" --dev-bind / / --unshare-net --die-with-parent -- /bin/true 2>&1); then
  check_child_output
  exec "$BWRAP" --dev-bind / / --unshare-net --die-with-parent -- "$@"
fi
NO_IP='
import errno, re, socket, sys
if not re.search(r"^Seccomp:\s*2$", open("/proc/self/status").read(), re.M): print("no seccomp filter on this process"); sys.exit(1)
opened = []
for family, fname in ((socket.AF_INET, "IPv4"), (socket.AF_INET6, "IPv6")):
    for kind, kname in ((socket.SOCK_STREAM, "TCP"), (socket.SOCK_DGRAM, "UDP")):
        try:
            socket.socket(family, kind).close()
            opened.append(f"{kname}/{fname} created")
        except OSError as e:
            if e.errno != errno.EPERM: opened.append(f"{kname}/{fname} {errno.errorcode.get(e.errno, e.errno)}")
if opened: print("IP sockets are not refused (" + ", ".join(opened) + ")"); sys.exit(1)
print("proved " + sys.argv[1])
'
why=$(drop '*'; exec "$VERIFIER" -I -S -c "$NO_IP" "$nonce" 2>&1)
status=$?
if [ "$status" -eq 0 ] && [ -n "$nonce" ] && [ "${why##*"$NL"}" = "proved $nonce" ]; then
  if [ -n "$imposed" ]; then
    echo 'devpanel-offline: isolation inherited: no network namespace can start here, so this wrapper installed a seccomp filter of its own that refuses every socket (proved: seccomp filter, EPERM creating TCP and UDP sockets, IPv4 and IPv6); loopback is refused too' >&2
  else
    echo 'devpanel-offline: isolation inherited: no network namespace here, but this runtime refuses IP sockets (proved: seccomp filter, EPERM creating TCP and UDP sockets, IPv4 and IPv6); loopback is refused too' >&2
  fi
  check_child_output
  exec "$@"
fi
unavailable () {
  echo "devpanel-offline: network isolation could not start in this seat: ${err:-bwrap unavailable}" >&2
  echo "devpanel-offline: and the runtime's own network denial is not proved: ${why:-verifier unavailable}" >&2
  [ -n "$1" ] && echo "devpanel-offline: and the wrapper could not impose one: $1" >&2
  echo 'devpanel-offline: the command was NOT run (no network fallback)' >&2
  exit 125
}
[ -n "$imposed" ] && unavailable 'the socket filter it installed did not pass the proof'
[ -x "$IMPOSER" ] || unavailable "no $IMPOSER"
# struct sock_filter is (u16 code, u8 jt, u8 jf, u32 k); seccomp_data holds nr at 0, arch at 4.
# On any failure it says the same lines as `unavailable` and exits 125 itself: this shell is gone by then.
IMPOSE='
import ctypes, errno, os, platform, socket, struct, sys
err, why, script = sys.argv[1:4]
def unavailable(reason):
    for line in ("network isolation could not start in this seat: " + err, "and the runtime\x27s own network denial is not proved: " + why,
                 "and the wrapper could not impose one: " + reason, "the command was NOT run (no network fallback)"):
        print("devpanel-offline: " + line, file=sys.stderr)
    sys.exit(125)
ARCH = {"x86_64": (0xC000003E, 41), "aarch64": (0xC00000B7, 198)}.get(platform.machine())
if not ARCH: unavailable("no socket filter is defined for " + platform.machine())
audit, nr_socket = ARCH
EPERM, ENOSYS, ALLOW = 0x00050000 | errno.EPERM, 0x00050000 | errno.ENOSYS, 0x7FFF0000
LD, JEQ, JGE, RET = 0x20, 0x15, 0x35, 0x06
prog = b"".join(struct.pack("HBBI", *i) for i in (
    (LD, 0, 0, 4), (JEQ, 1, 0, audit), (RET, 0, 0, EPERM),
    (LD, 0, 0, 0), (JGE, 0, 1, 0x40000000), (RET, 0, 0, EPERM),
    (JEQ, 0, 1, nr_socket), (RET, 0, 0, EPERM),
    (JEQ, 0, 1, 425), (RET, 0, 0, ENOSYS),
    (RET, 0, 0, ALLOW)))
class Fprog(ctypes.Structure): _fields_ = [("len", ctypes.c_ushort), ("filter", ctypes.c_void_p)]
buf = ctypes.create_string_buffer(prog, len(prog))
libc = ctypes.CDLL(None, use_errno=True)
if libc.prctl(38, 1, 0, 0, 0) or libc.prctl(22, 2, ctypes.byref(Fprog(len(prog) // 8, ctypes.addressof(buf))), 0, 0):
    unavailable("prctl refused the filter (" + os.strerror(ctypes.get_errno()) + ")")
try:
    socket.socket(socket.AF_INET, socket.SOCK_STREAM).close()
    unavailable("the filter it installed does not refuse sockets")
except PermissionError: pass
try: os.execve("/bin/sh", ["/bin/sh", script] + sys.argv[4:], dict(os.environ, DEVPANEL_OFFLINE_IMPOSED="1"))
except OSError as e: unavailable("its second pass could not start (" + str(e) + ")")
'
exec "$IMPOSER" -I -S -c "$IMPOSE" "${err:-bwrap unavailable}" "${why:-verifier unavailable}" "$0" "$@"
