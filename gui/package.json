{
  "name": "devpanel-gui",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "devpanel GUI — Node + socket.io backend with a Vue 3 + Vuetify dashboard",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node test/run.mjs",
    "config:check": "node server/config/check.mjs",
    "publish:check": "node ../tools/publish-check.mjs",
    "preview": "node server/runtime/preview-cli.mjs",
    "overview": "node tools/overview.mjs",
    "supervisor-calls": "node tools/supervisor-calls.mjs",
    "selftest-history": "node tools/selftest-history.mjs",
    "drive-records": "node tools/drive-records.mjs",
    "live": "node live/check.mjs",
    "contract": "node live/cli-contract.mjs",
    "policy:gemini": "node live/gemini-policy-check.mjs",
    "visual": "node test/run.mjs visual.chromium"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.2.1",
    "markdown-it": "15.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.63.0",
    "sass-embedded": "^1.104.0",
    "vite": "^8.2.2",
    "vite-plugin-vuetify": "^2.1.3"
  }
}
